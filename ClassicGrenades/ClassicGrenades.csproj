<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>ClassicGrenades</RootNamespace>
    <AssemblyName>ClassicGrenades</AssemblyName>
    <Version>1.0.0</Version>
    <Description>HE/SCP-018 — гранаты не бьют тиммейтов (LabAPI 1.1.6).</Description>
    <Authors>SteamTime</Authors>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <NoWarn>CS1591;CS0436;NU1701</NoWarn>
    <ScpslManagedDir Condition=" '$(ScpslManagedDir)' == '' ">$(HOME)/scpsl_server/SCPSL_Data/Managed/</ScpslManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="LabApi">
      <HintPath>$(ScpslManagedDir)LabApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ScpslManagedDir)Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(ScpslManagedDir)Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror">
      <HintPath>$(ScpslManagedDir)Mirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ScpslManagedDir)UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ScpslManagedDir)UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="YamlDotNet">
      <HintPath>$(ScpslManagedDir)YamlDotNet.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
